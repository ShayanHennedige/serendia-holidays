# AI itinerary generation (optional; the local catalogue fallback works without it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Final tour submission storage (the PDF itself is never stored)
STAFF_DASHBOARD_TOKEN=replace-with-a-private-staff-access-token
# TOUR_SUBMISSION_DIRECTORY=/absolute/private/storage/path
# PUPPETEER_EXECUTABLE_PATH=/absolute/path/to/chrome

# Mapbox server token with Geocoding v6 permanent-storage and Static Images access
MAPBOX_ACCESS_TOKEN=

# WhatsApp Business Cloud API
# Use "cloud" for direct Meta delivery or "log" for local simulation.
WHATSAPP_DELIVERY_MODE=cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
COMPANY_WHATSAPP_NUMBER=947XXXXXXXX
